# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.local

# ROS 2
build/
install/
log/

# ML / datasets (large artifacts — use DVC or external storage later)
ml/models/*.pt
ml/models/*.onnx
# Keep versioned small MLP artifacts for PHP-13 / edge smoke tests
!ml/models/plant-health-mlp-*.pt
!ml/models/plant-health-mlp-*.onnx
# Classical baseline .joblib may be committed when small; ignore huge dumps:
# ml/models/*.joblib
ml/datasets/**/images/
ml/datasets/**/metadata/records.jsonl
!ml/datasets/**/.gitkeep
# Keep latest evaluation report; ignore stamped runs
ml/evaluation/reports/*
!ml/evaluation/reports/latest_baseline_eval.json
!ml/evaluation/reports/.gitkeep

# Node (future frontend/backend)
node_modules/
dist/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Secrets
*.pem
credentials.json

frontend/node_modules/
frontend/dist/
backend/*.db
