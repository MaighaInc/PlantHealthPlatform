# PlantHealthPlatform — environment template
# Copy to .env and adjust. Never commit secrets.

# Runtime mode: SIMULATION | DEVELOPMENT | HARDWARE | PRODUCTION
DEVELOPMENT_MODE=SIMULATION

# Logging
LOG_LEVEL=INFO

# Camera (used from PHP-05+)
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15

# Irrigation safety thresholds (used from PHP-16+)
SOIL_THRESHOLD=30.0
IRRIGATION_MAX_SECONDS=30

# Database (used from PHP-19+)
# DATABASE_URL=postgresql://upsilon:upsilon@localhost:5432/planthealth

# ML model path (used from PHP-14+)
# MODEL_PATH=ml/models/plant-health-classifier-1.0.0.joblib
